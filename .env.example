POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
# Local development (make run_app). From the Docker app container, use host.docker.internal.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=pyrolabs-local

OPENAI_API_KEY=
OPEN_ROUTER_API_KEY=
MISTRAL_API_KEY=
GEMINI_API_KEY=

LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# LANGFUSE_BASE_URL=https://cloud.langfuse.com

# External MLflow (not started by this repo). Host evals default to this URI.
MLFLOW_TRACKING_URI=http://127.0.0.1:5000
